# ==========================================
# EXCHANGE SELECTION (binance OR delta)
# ==========================================
# Set EXCHANGE=binance to trade on Binance Futures (World's #1 liquidity)
# Set EXCHANGE=delta to trade on Delta Exchange
EXCHANGE=binance
SYMBOL=BTC/USDT
SYMBOLS=BTC/USDT,ETH/USDT

# ------------------------------------------
# BINANCE CREDENTIALS:
# ------------------------------------------
# • Live API keys: Binance -> Profile -> API Management (Enable Futures permission)
# • Testnet keys:  https://testnet.binancefuture.com (Log in & get free test USDT)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ------------------------------------------
# DELTA CREDENTIALS (if using EXCHANGE=delta):
# ------------------------------------------
# API_KEY=your_delta_api_key_here
# API_SECRET=your_delta_api_secret_here
# DELTA_INDIA=false

# ------------------------------------------
# TESTNET vs LIVE:
# ------------------------------------------
# Set USE_TESTNET=true for Testnet (Binance Testnet or Delta Demo)
# Set USE_TESTNET=false for Real Live Trading
USE_TESTNET=false

# ------------------------------------------
# EXECUTION MODE:
# ------------------------------------------
# For Real Exchange Orders: PAPER_TRADING=false and LIVE_TRADING=true
# For Zero-Risk Simulation: PAPER_TRADING=true and LIVE_TRADING=false
PAPER_TRADING=false
LIVE_TRADING=true

# Market Data Feed for SMC Calculations & Real-time Prices:
# 'binance' (Recommended): Uses high-liquidity live Binance futures candles (matches TradingView).
# 'live_delta': Uses real live Delta public candles.
# 'exchange': Uses the connected exchange (caution: Delta Demo testnet has distorted mock prices).
MARKET_DATA_PROVIDER=binance

# ==========================================
# TRADINGVIEW WEBHOOK BRIDGE
# ==========================================
WEBHOOK_PORT=5000
WEBHOOK_SECRET=delta_tradingview_secret

# ==========================================
# RISK & STRATEGY SETTINGS
# ==========================================
# Setup Timeframe for Structure & Zones (15m for intraday SMC, or 1h for swing):
SETUP_TIMEFRAME=15m

# Execution Timeframe for Entry Triggers (5m or 15m):
LTF=5m

# Minimum Confluence Score for Entry (70-85, recommended 75 for A/A+ institutional setups):
MIN_CONFLUENCE_SCORE=75

RISK_PER_TRADE=0.01
LEVERAGE=10

# Session Filter:
# Set false to trade 24/7 in crypto (Recommended for active markets)
# Set true to trade ONLY during London (07:00-10:30 UTC) & NY (12:30-19:00 UTC)
ENABLE_SESSION_FILTER=false

MAX_DAILY_LOSS_PCT=0.03

# ==========================================
# INSTITUTIONAL SMC & PRECISION ENTRY CONTROLS
# ==========================================
# Maximum Drift from Zone Edge (Default 0.0025 = 0.25%):
# Strictly prevents chasing price when market has already extended away from OB/FVG
MAX_OVEREXTENSION_PCT=0.0025

# Enforce ICT Premium & Discount Array (Default true):
# Strictly enforces: Longs ONLY in Discount (<50%), Shorts ONLY in Premium (>50%)
REQUIRE_DISCOUNT_PREMIUM=true

# Prioritize Optimal Trade Entry (OTE - 61.8% to 78.6% Fibonacci Retracement)
ENABLE_OTE_FILTER=true

# Minimum FVG gap size relative to ATR (filters out micro-tick spread noise):
MIN_GAP_ATR_RATIO=0.25

# Intraday Institutional Session VWAP Alignment (+8 pts when aligned, penalty when counter):
ENABLE_VWAP_FILTER=true

# BTC Macro Correlation Filter (Blocks altcoins like ETH from trading against BTC trend):
ENABLE_BTC_CORRELATION=true

# ==========================================
# DYNAMIC PROFIT RATCHET & CHOP PROTECTION
# ==========================================
# Dynamic Profit Ratchet (Trails stop to lock in +35% to +60% profit as price approaches TP):
ENABLE_TRAILING_STOP=true
TRAILING_STOP_TRIGGER_PCT=0.65

# Stale Trade Duration Guard (Exits dead consolidation trades after 36 5m bars = 3 hours):
MAX_TRADE_DURATION_BARS=36
