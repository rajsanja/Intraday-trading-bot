# ==========================================
# DELTA EXCHANGE CONFIGURATION
# ==========================================
EXCHANGE=delta
SYMBOL=BTC/USDT
SYMBOLS=BTC/USDT,ETH/USDT

# API Credentials from Delta Exchange (demo or live):
API_KEY=your_delta_api_key_here
API_SECRET=your_delta_api_secret_here

# Set USE_TESTNET=true for demo (demo.delta.exchange) or false for real live Delta
USE_TESTNET=true

# Execution Mode:
# To place orders on exchange: set PAPER_TRADING=false and LIVE_TRADING=true
# For local paper simulation: set PAPER_TRADING=true and LIVE_TRADING=false
PAPER_TRADING=false
LIVE_TRADING=true

# Set to true if using Delta India (india.delta.exchange):
DELTA_INDIA=false

# ==========================================
# RISK & STRATEGY SETTINGS
# ==========================================
# Setup Timeframe for Structure & Zones (15m for intraday SMC, or 1h for swing):
SETUP_TIMEFRAME=15m

# Execution Timeframe for Entry Triggers (5m or 15m):
LTF=5m

# Minimum Confluence Score for Entry (60-85, default 65):
MIN_CONFLUENCE_SCORE=65

RISK_PER_TRADE=0.01
LEVERAGE=10

# Session Filter:
# Set false to trade 24/7 in crypto (Recommended for active markets)
# Set true to trade ONLY during London (07:00-10:30 UTC) & NY (12:30-19:00 UTC)
ENABLE_SESSION_FILTER=false

MAX_DAILY_LOSS_PCT=0.03

# ==========================================
# INSTITUTIONAL SMC & PRECISION ENTRY CONTROLS
# ==========================================
# Maximum Drift from Zone Edge (Default 0.0035 = 0.35%):
MAX_OVEREXTENSION_PCT=0.0035

# Enforce ICT Premium & Discount Array (Default true):
REQUIRE_DISCOUNT_PREMIUM=true

# Prioritize Optimal Trade Entry (OTE - 61.8% to 78.6% Fibonacci Retracement)
ENABLE_OTE_FILTER=true

# Minimum FVG gap size relative to ATR (filters out noise):
MIN_GAP_ATR_RATIO=0.20
